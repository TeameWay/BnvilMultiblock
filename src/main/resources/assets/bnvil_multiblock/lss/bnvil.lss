// ─────────────────────────────────────────────────────────────────────────────
//  Bnvil 界面主题
//
//  全模组唯一的 LSS。上半部分是基底，管面板、按钮、槽位、滚动条这些通用控件；
//  下半部分只服务本模组的控制器、端口方块与端口浮层。
//
//  PALETTE（对比度都按 surface #222222 计）
//    canvas   #1a1a1a   background 与 ansiBlack 之间，最底层
//    surface  #222222   terminal.background
//    raised   #2a2a2a   面板与控件静息态
//    hovered  #323232
//    disabled #2e2e2e
//    deep     #151515   ansiBlack，代码编辑器这类深色底
//    line     #1fffffff  12% 白，发丝线
//    line+    #33ffffff  20% 白
//    text     #d0d0d0   terminal.foreground，10.3:1
//    title    #f5f5f5   ansiBrightWhite
//    dim      #a0a0a0   由 foreground 压暗，6.1:1
//    faint    #6f6f6f   由 ansiBrightBlack 提亮，仅用于禁用态
//    accent   #6c99bb   ansiBlue，5.2:1
//    accent+  #86b6d9   提亮后的悬停色
//    accent-  #547c99   ansiBrightBlue，这组配色里 bright 反而更暗
//    success  #7b9246   ansiGreen
//    warn     #d3a04d   ansiYellow
//    danger   #a53c23   ansiRed，只做填充与描边，2.5:1 不能当文字
//    danger+  #d97a5c   提亮后的红字，5.2:1
//    info     #7dd6cf   ansiCyan
//
//  终端色里的 success / warn / info / magenta 目前在规则里没有对应控件，
//  先列出来，以后加状态色直接取，不用回头翻原配色。
//
//  写规则的三条约束：
//  1. 覆盖已有规则时用 #界面id 或类前缀提高权重（id 100 > 类 10 > 元素 1），
//     不要靠书写顺序取胜，后加的规则会把它顶掉。
//  2. 每个类都要在 Java 侧有唯一的 addClass 位置，不留空选择器。
//  3. 尺寸（width/height/flex/margin/padding/gap）归 Java 的 ControllerLayout
//     与 PortUI；写在这里会和内联样式冲突，而内联的优先级更高。
//
//  注意：sdf() 的四个圆角依次读 左上 右上 右下 左下，与 CSS 同序。
//  注意：红底按钮必须用浅色文字。#1a1a1a 在 #a53c23 上只有 2.7:1，这里用 #f5f5f5。
//
//  强调色只用在需要表态的地方：聚焦、选中、开启、进度；其余控件保持灰色。
// ─────────────────────────────────────────────────────────────────────────────

// ── 表面 ─────────────────────────────────────────────────────────────────────
.panel_bg {
  background: sdf(#f21a1a1a, 7, 1, #1fffffff);
  padding-all: 6;
  gap-all: 5;
}

.preview_bg {
  background: sdf(#1a1a1a, 6, 1, #1fffffff);
  padding-all: 4;
}

.configurator_preview_bg {
  background: sdf(#1a1a1a, 6, 1, #1fffffff);
  padding-all: 4;
}

// ── 文字 ─────────────────────────────────────────────────────────────────────
text, label {
  text-shadow: false;
  text-color: #d0d0d0;
  font: ldlib2:jetbrains_mono_bold;
}

// ── 按钮 ─────────────────────────────────────────────────────────────────────
// 默认中性。满屏强调色按钮会让界面像玩具；强调色只留给确认按钮，那里它才真的表示同意。
button:host {
  base-background: sdf(#2a2a2a, 5, 1, #1fffffff);
  hover-background: sdf(#323232, 5, 1, #33ffffff);
  pressed-background: sdf(#1a1a1a, 5, 1, #33ffffff);
  padding-all: 3;
  height: 16;
}

// 图标本身是白色的，在这套深色按钮上已经看得清，所以 white_icon 提示不把它染成文字色。
button:host > .__white_icon__,
button.__white_icon__ > .__icon__ {
  color: #ffffff;
}

button:host .__button_text__ {
  text-color: #d0d0d0;
  text-shadow: false;
}

button:disabled:host {
  base-background: sdf(#2e2e2e, 5, 1, #24ffffff);
}

button:disabled:host .__button_text__ {
  text-color: #6f6f6f;
  text-shadow: false;
}

.__confirm-button__ {
  base-background: sdf(#6c99bb, 5);
  hover-background: sdf(#86b6d9, 5);
  pressed-background: sdf(#547c99, 5);
}

.__confirm-button__ .__button_text__ {
  text-color: #1a1a1a;
}

.__reject-button__ {
  base-background: sdf(#a53c23, 5);
  hover-background: sdf(#c9573a, 5);
  pressed-background: sdf(#8c3220, 5);
}

.__reject-button__ .__button_text__ {
  text-color: #f5f5f5;
}

// ── 文本输入 ─────────────────────────────────────────────────────────────────
// 注意：输入框自己画文字，`text, label` 管不到它；TEXT_COLOR 默认白色，CURSOR_COLOR
// 也接近白色。这里故意不写 :host：该伪类只匹配不属于其他组件的元素，颜色选择器
// 内部的输入框落在它外面，之前白底白字就是这么来的。这里只设颜色，边框留给下面
// 带 :host 的规则，组件给自己的输入框设样式时仍能接管。
text-field, text-area {
  text-color: #d0d0d0;
  cursor-color: #d0d0d0;
  text-shadow: false;
}

text-field:host,
.__tag-field_text-field__,
.__search-component_text-field__ {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #6c99bb);
  padding-all: 3;
  font: ldlib2:jetbrains_mono_bold;
}

search-component:host {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #6c99bb);
  height: 16;
}

// ── 开关 ─────────────────────────────────────────────────────────────────────
switch:host {
  base-background: sdf(#323232, 6);
  pressed-background: sdf(#6c99bb, 6);
  unmark-background: sdf(#a0a0a0, 5);
  mark-background: sdf(#1a1a1a, 5);
  height: 12;
  width: 22;
  padding-all: 1;
}

// ── 下拉选择 ─────────────────────────────────────────────────────────────────
selector:host {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #6c99bb);
  height: 16;
}

selector:host:hovered {
  background: sdf(#323232, 5, 1, #33ffffff);
}

.__selector_button-icon__ {
  background: sprite(ldlib2:textures/gui/down.png) scale(0.55) color(#a0a0a0);
}

.__selector_dialog__, .__search-component_dialog__ {
  background: sdf(#f2222222, 7, 1, #33ffffff);
  padding-all: 3;
}

// ── 进度条 ───────────────────────────────────────────────────────────────────
progress-bar:host {
  height: 8;
}

progress-bar:host label {
  font-size: 6;
  text-color: #d0d0d0;
  font: ldlib2:jetbrains_mono_bold;
}

.__progress-bar_bar-container__ {
  background: sdf(#2a2a2a, 4, 1, #1fffffff);
  padding-all: 0;
}

.__progress-bar_bar__ {
  background: sdf(#6c99bb, 4);
  padding-all: 0;
}

// ── 槽位 ─────────────────────────────────────────────────────────────────────
item-slot, .item-slot_bg {
  background: sdf(#2a2a2a, 4, 1, #1fffffff);
  hover-overlay: sdf(#24ffffff, 4);
}

fluid-slot, .fluid-slot_bg {
  background: sdf(#2a2a2a, 4, 1, #1fffffff);
}

// ── 颜色选择器 ───────────────────────────────────────────────────────────────
color-selector:host text-field {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
  focus-overlay: sdf(#00000000, 5, 1, #6c99bb);
  padding-all: 3;
  font: ldlib2:jetbrains_mono_bold;
}

color-selector:host button {
  base-background: sdf(#2a2a2a, 4, 1, #1fffffff);
  hover-background: sdf(#323232, 4, 1, #33ffffff);
  pressed-background: sdf(#1a1a1a, 4, 1, #33ffffff);
}

color-selector:host .__color-selector_alpha-slider__ {
  background: sdf(#2a2a2a, 4, 1, #1fffffff);
  margin-right: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-slider__ {
  background: sdf(#2a2a2a, 4, 1, #1fffffff);
  margin-bottom: 3;
  padding-all: 2;
}

color-selector:host .__color-selector_color-preview__ {
  background: sdf(#2a2a2a, 4, 1, #1fffffff);
  margin-right: 3;
  margin-bottom: 3;
  padding-all: 2;
}

// ── 切换开关 ─────────────────────────────────────────────────────────────────
toggle:host {
  mark-background: sdf(#3a6c99bb, 4, 1, #6c99bb);
  height: 14;
}

.__toggle_button__ {
  base-background: sdf(#2a2a2a, 4, 1, #1fffffff);
  hover-background: sdf(#323232, 4, 1, #33ffffff);
  pressed-background: sdf(#1a1a1a, 4, 1, #33ffffff);
}

toggle:on .__toggle_button__ {
  base-background: sdf(#3a6c99bb, 4, 1, #6c99bb);
  hover-background: sdf(#556c99bb, 4, 1, #86b6d9);
  pressed-background: sdf(#3a547c99, 4, 1, #6c99bb);
}

.__toggle_mark-icon__ {
  margin-all: 2;
  width: auto;
  height: auto;
  flex: 1;
}

// ── 文本域 ───────────────────────────────────────────────────────────────────
text-area {
  scroller-view-margin: 8;
  font: ldlib2:jetbrains_mono_bold;
}

text-area:host {
  focus-overlay: sdf(#00000000, 5, 1, #6c99bb);
}

// 树形列表的箭头贴图是白色的。深色行上本来就看得到，这里仍把它染成暗色文字，
// 免得它比旁边的标签还抢眼。
tree-list {
  collapse-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 188, 240, 5, 5) color(#a0a0a0);
  expand-icon: sprite(ldlib2:textures/gui/icon/gdp_icons.png, 132, 230, 5, 5) color(#a0a0a0);
}

.__text-area_content-view__ {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
  padding-all: 3;
}

.__text-area_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__text-area_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

// ── 滚动条 ───────────────────────────────────────────────────────────────────
// 只留轨道和滑块。两端按钮已经去掉：滚轮之后没人再点滚动条箭头，
// 它们还要占掉每个滚动条的两段空间。
scroller-horizontal:host {
  height: 5;
}

scroller-vertical:host {
  width: 5;
}

.__scroller_scroll_container__ {
  background: sdf(#24ffffff, 3);
  padding-all: 0;
}

scroller-horizontal .__scroller_scroll_bar__,
scroller-vertical .__scroller_scroll_bar__ {
  base-background: sdf(#40ffffff, 3);
  hover-background: sdf(#73ffffff, 3);
  pressed-background: sdf(#6c99bb, 3);
}

.__scroller_head_button__, .__scroller_tail_button__ {
  display: none;
}

scroller-view {
  scroller-view-margin: 8;
}

.__scroller_view_view-port__ {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
  padding-all: 3;
}

.__scroller_view_horizontal-scroller__ {
  height: 5;
  margin-top: 2;
}

.__scroller_view_vertical-scroller__ {
  width: 5;
  margin-left: 2;
}

// ── 滑块 ─────────────────────────────────────────────────────────────────────
slider-horizontal:host {
  height: 10;
}

slider-vertical:host {
  width: 10;
}

slider-horizontal, slider-vertical {
  slider-track-size: 3;
  slider-handle-size: 5;
}

.__slider_track__ {
  background: sdf(#2a2a2a, 2, 1, #1fffffff);
}

.__slider_fill__ {
  background: sdf(#6c99bb, 2);
}

.__slider_handle__ {
  base-background: sdf(#d0d0d0, 3);
  hover-background: sdf(#6c99bb, 3);
  pressed-background: sdf(#547c99, 3);
}

// ── 标签页 ───────────────────────────────────────────────────────────────────
// 页头与内容用同一块表面，中间只留一条缝，一排标签读起来才是一张卡片，
// 而不是盖在盒子上的盖子。
.__tab-view_tab_header_container__ {
  background: sdf(#2a2a2a, 7 7 0 0, 1, #1fffffff);
  margin-bottom: -1;
  padding-all: 3;
}

.__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 3;
}

.__tab-view_tab_content_container__ {
  background: sdf(#222222, 0 0 7 7, 1, #1fffffff);
}

tab-view .__tab-view_tab_scroller__ {
  margin-bottom: 0;
}

tab:host {
  base-background: empty;
  hover-background: sdf(#1fffffff, 5);
  pressed-background: sdf(#3a6c99bb, 5);
  padding-all: 3;
  height: 16;
}

tab:host:selected {
  base-background: sdf(#222222, 5 5 0 0);
  hover-background: sdf(#222222, 5 5 0 0);
  pressed-background: sdf(#222222, 5 5 0 0);
}

tab:host:not(tab:selected) label {
  text-color: #a0a0a0;
  text-shadow: false;
}

// ── 对话框 ───────────────────────────────────────────────────────────────────
.__dialog_title__ {
  background: sdf(#2a2a2a, 7 7 0 0, 1, #33ffffff);
  transform: translateY(1);
}

.__dialog_title__ > label {
  text-color: #d0d0d0;
}

.__dialog_content-container__ {
  background: sdf(#f2222222, 0, 1, #33ffffff);
}

.__dialog_button-container__ {
  background: sdf(#f2222222, 0 0 7 7, 1, #33ffffff);
  transform: translateY(-1);
}

// ── 菜单 ─────────────────────────────────────────────────────────────────────
menu {
  background: sdf(#f2222222, 6, 1, #33ffffff);
  arrow: sprite(ldlib2:textures/gui/right.png) scale(0.55) color(#a0a0a0);
}

// ── 编辑器 ───────────────────────────────────────────────────────────────────
.__editor__ code-editor {
  background: sdf(#151515, 6, 1, #33ffffff);
}

.__editor_top__ {
  background: sdf(#2a2a2a, 6 6 0 0);
}

.__editor__ button:host {
  base-background: sdf(#00000000, 5, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 5, 1, #33ffffff);
  pressed-background: sdf(#3a6c99bb, 5, 1, #6c99bb);
}

.__editor__ tab:host {
  height: 15;
}

.__editor-gizmo-bar__ {
  background: sdf(#f21a1a1a, 6, 1, #33ffffff);
}

.__view-container__ {
  background: sdf(#1a1a1a);
}

.__view-container_tab-view__ .__tab-view_tab_content_container__ {
  padding-all: 3;
}

.__view-container_collapse-button__ {
  height: 14;
  width: 14;
}

ResourceView .__tab-view_tab_header_container__ .__scroller_view_view-container__ {
  gap-all: 2;
}

ResourceView tab:host {
  base-background: empty;
  hover-background: sdf(#1fffffff, 5) scale(0.92);
  pressed-background: sdf(#3a6c99bb, 5) scale(0.92);
}

ResourceView tab:host:selected {
  base-background: sdf(#222222, 5) scale(0.92);
  hover-background: sdf(#2a2a2a, 5) scale(0.92);
  pressed-background: sdf(#2a2a2a, 5) scale(0.92);
}

/* 一个圆角形状切成两半：页头圆朝外的那侧，内容圆另一侧，各自向对方挪一像素，
   两条边就并成一条缝。圆哪几个角跟着 placement 变；注意圆角顺序是
   左上、右上、右下、左下。 */
.__resource-view_placement-left__ .__tab-view_tab_header_container__ {
  background: sdf(#1a1a1a, 7 0 0 7, 1, #1fffffff);
  transform: translate(1, 0);
}

.__resource-view_placement-left__ .__tab-view_tab_content_container__ {
  background: sdf(#222222, 0 7 7 0, 1, #1fffffff);
}

.__resource-view_placement-right__ .__tab-view_tab_header_container__ {
  background: sdf(#1a1a1a, 0 7 7 0, 1, #1fffffff);
  transform: translate(-1, 0);
}

.__resource-view_placement-right__ .__tab-view_tab_content_container__ {
  background: sdf(#222222, 7 0 0 7, 1, #1fffffff);
}

.__resource-view_placement-top__ .__tab-view_tab_header_container__ {
  background: sdf(#1a1a1a, 7 7 0 0, 1, #1fffffff);
  transform: translate(0, 1);
}

.__resource-view_placement-top__ .__tab-view_tab_content_container__ {
  background: sdf(#222222, 0 0 7 7, 1, #1fffffff);
}

.__resource-view_placement-bottom__ .__tab-view_tab_header_container__ {
  background: sdf(#1a1a1a, 0 0 7 7, 1, #1fffffff);
  transform: translate(0, -1);
}

.__resource-view_placement-bottom__ .__tab-view_tab_content_container__ {
  background: sdf(#222222, 7 7 0 0, 1, #1fffffff);
}

.__resource-view_tab-placeholder__ {
  background: sdf(#3a6c99bb, 5);
}

.__ui-editor-view_header__ {
  background: sdf(#222222);
}

.__ui-editor-view_header__ button {
  height: 14;
}

.__ui-editor-view_header__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 4, 1, #33ffffff);
  pressed-background: sdf(#3a6c99bb, 4, 1, #6c99bb);
}

.__ui-editor-view_canvas__ {
  background: #1a1a1a;
}

.__ui-editor-view_builtin-styles-toggle__ {
  height: 14;
  padding-all: 0;
  mark-background: sdf(#00000000, 4, 1, #6c99bb);
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 4, 1, #33ffffff);
}

.__ui-editor-view_builtin-styles-toggle__ .__toggle_mark-icon__ {
  margin-all: 0;
}

.__ui-editor-view_style-view__ {
  background: empty;
  gap-all: 3;
}

.__editor-window_active__ {
  background: #6c99bb;
}

.__editor-window_inactive__ {
  background: #2a2a2a;
}

// ── 配置器 ───────────────────────────────────────────────────────────────────
.__configurator-group__ .__configurator-group_container__ {
  background: sdf(#222222, 0 6 6 6, 1, #1fffffff);
}

.__configurator-group__ > .__configurator_line__ {
  background: sdf(#1a1a1a, 5, 1, #1fffffff);
}

.__configurator-group__ > .__configurator_line__:hovered:not(:disabled) {
  background: sdf(#2a2a2a, 5, 1, #33ffffff);
}

.__configurator-group__ > .__configurator_line__ > .__configurator_label__ {
  text-color: #a0a0a0;
  text-shadow: false;
}

ToggleSelectorConfigurator .__toggle_mark-icon__ {
  margin-all: 0;
}

ToggleSelectorConfigurator .__toggle_button__ {
  base-background: sdf(#00000000, 4, 1, #1fffffff);
  hover-background: sdf(#1fffffff, 4, 1, #33ffffff);
  pressed-background: sdf(#3a6c99bb, 4, 1, #6c99bb);
}

.__array-configurator_button-group__ {
  background: sdf(#00000000, 5, 1, #1fffffff);
  padding-all: 2;
}

.__array-configurator_item_selected__ {
  background: sdf(#3a6c99bb, 4, 1, #6c99bb);
}

// ── 节点图 ───────────────────────────────────────────────────────────────────
.__blackboard-var-prop_title-bar__ {
  background: sdf(#2a2a2a, 6 6 0 0, 1, #1fffffff);
}

.__blackboard-var-prop_content__ {
  background: sdf(#222222, 0 0 6 6, 1, #1fffffff);
}

.__node-graph-view_canvas__ {
  background: #1e1e1e;
}

.__node-graph-view_canvas-view__ {
  color: #7a7a7a;
}

.__node-element__ {
  background: sdf(#f21a1a1a, 6, 1, #33ffffff);
}

.__node-title-element__ {
  background: sdf(#2a2a2a, 6 6 0 0, 1, #1fffffff);
  padding-bottom: 4;
}

.__node-port-container__ {
  background: sdf(#00000000, 0 0 6 6);
}

.__in-out-port-container_input__ {
  background: sdf(#00000000);
  margin-all: 1;
}

.__in-out-port-container_output__ {
  background: sdf(#24ffffff);
  margin-all: 1;
}

.__capsule-node__ {
  background: sdf(#fa2a2a2a, 8, 1, #33ffffff);
}

.__capsule-node__ .__node-title-element__ {
  background: empty;
  padding-bottom: 0;
}

.__capsule-node__ .__node-port-container__ {
  background: empty;
}

.__context-node__ > .__node-title-element__ {
  height: 30;
  gap-all: 5;
}

.__block-node__ > .__node-title-element__ {
  background: sdf(#3a6c99bb, 6 6 0 0, 1, #6c99bb);
}

.__block-list-container__ {
  background: sdf(#2a2a2a, 6);
}

.__subgraph-node__ .__node-title-element__ {
  background: sdf(#323232, 6 6 0 0, 1, #33ffffff);
}

.__vertical-port-container__ {
  padding-all: 2;
  gap-all: 4;
}

.__vertical-port__ {
  padding-all: 1;
}

.__node-preview__ {
  background: sdf(#2a2a2a, 0 0 6 6, 1, #1fffffff);
  padding-all: 3;
}

.__item-library__ {
  background: sdf(#f2222222, 7, 1, #6c99bb);
}

.__item-library_description-panel__ {
  background: sdf(#f21a1a1a, 7, 1, #1fffffff);
  padding-all: 6;
  gap-all: 5;
}

// ── 按键映射 ─────────────────────────────────────────────────────────────────
.__keymap_chord__ {
  background: sdf(#2a2a2a, 5, 1, #1fffffff);
}

.__keymap_chord__:hovered {
  background: sdf(#2e2e2e, 5, 1, #33ffffff);
}

.__keymap_chord__.__capturing__ {
  background: sdf(#2a2a2a, 5, 1, #6c99bb);
}

.__keymap_chord-text__ {
  text-color: #d0d0d0;
  text-shadow: false;
}

.__keymap_chord__.__conflict__ .__keymap_chord-text__ {
  text-color: #d97a5c;
}

// ═════════════════════════════════════════════════════════════════════════════
//  模组界面
//
//  下面只服务控制器、端口方块与端口浮层；通用控件的外观都在上半部分。
// ═════════════════════════════════════════════════════════════════════════════

// ── 文本层级 ─────────────────────────────────────────────────────────────────
// 字体与正文颜色由基底的 `text, label` 统一设置，这里只分层：
// 标题用 title，说明退到 dim，配方小节用 accent。
.bnvil-title {
  text-color: #f5f5f5;
}

.bnvil-hint {
  text-color: #a0a0a0;
}

.bnvil-section {
  text-color: #6c99bb;
}

// 结构状态。三个类互斥，由 ControllerUI 在状态变化时切换。
.bnvil-state-idle {
  text-color: #a0a0a0;
}

.bnvil-state-working {
  text-color: #6c99bb;
}

.bnvil-state-error {
  text-color: #d97a5c;
}

// ── 控制器 ───────────────────────────────────────────────────────────────────
// 选中卡片只换类名，填充和描边都要区分三态；只改悬停色的话，选中和悬停分不出来。
#bnvil-controller .controller-thread-card {
  background: sdf(#2a2a2a, 3, 1, #1fffffff);
  transition: background 0.12;
}

#bnvil-controller .controller-thread-card:hover {
  background: sdf(#323232, 3, 1, #33ffffff);
}

#bnvil-controller .controller-thread-card.controller-thread-selected {
  background: sdf(#3a6c99bb, 3, 1, #6c99bb);
}

// 栏与栏之间的分隔线：一像素宽，圆角看不出来，用 rect 即可。
#bnvil-controller .controller-divider {
  background: rect(#33ffffff);
}

// ── 紧凑滚动条 ───────────────────────────────────────────────────────────────
// 右栏只有 149 像素宽。上半部分的 5 像素滚动条加 3 像素内边距要吃掉 16 像素，
// 卡片里的配方 ID 会被截得太短，这里压到 4 和 1，并去掉内容区底色。
// 用 id 前缀是为了压过上半部分的同名规则，不靠书写顺序。
#bnvil-controller scroller-vertical:host,
#bnvil-port-panel scroller-vertical:host {
  width: 4;
}

#bnvil-controller .__scroller_view_view-port__,
#bnvil-port-panel .__scroller_view_view-port__ {
  padding-all: 1;
  background: empty;
}

// ── 端口浮层 ─────────────────────────────────────────────────────────────────
// 浮层盖在控制器界面之上，还能拖到任意位置，需要自己的表面和比卡片略重的描边，
// 否则会被读成页面里的又一行。
// 面板自己就是 #bnvil-port-panel，所以这条用控制器根前缀；
// 卡片和标题是它的子元素，可以继续用 id 前缀。
#bnvil-controller .port-panel {
  background: sdf(#222222, 4, 1, #40ffffff);
  z-index: 10;
}

#bnvil-port-panel .port-panel-title {
  background: sdf(#2a2a2a, 3);
}

#bnvil-port-panel .port-panel-card {
  background: sdf(#2a2a2a, 3, 1, #1fffffff);
  z-index: 1;
  transition: background 0.12;
}

#bnvil-port-panel .port-panel-card:hover {
  background: sdf(#323232, 3, 1, #33ffffff);
}
